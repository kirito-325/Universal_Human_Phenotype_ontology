    "QuoteReference": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "description": "Exact document_id returned by read_document for the window containing this quote. Abstract PMID and full-text PMC documents are distinct sources even for the same paper.",
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "quote": {
          "description": "One exact contiguous substring copied from a read window of the named document; never paraphrase or join fragments.",
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "span_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional exact host-provided absolute offset; omit rather than estimate.",
          "title": "Span Start"
        }
      },
      "required": [
        "document_id",
        "quote"
      ],
      "title": "QuoteReference",
      "type": "object"
    },
    "ReasoningStep": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "description": "Applicability assumptions, required for inference; empty for literature/phenotype_definition. Do not add assumptions_note/basis_notes.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "basis": {
          "description": "literature: exact cited facts, no assumptions; inference: cited premises plus assumptions; model_knowledge: learned premise, no citations; phenotype_definition: first input-only step.",
          "enum": [
            "phenotype_definition",
            "literature",
            "inference",
            "model_knowledge"
          ],
          "title": "Basis",
          "type": "string"
        },
        "citations": {
          "description": "Exact read-source quotations for this step, not source IDs alone. Empty for model_knowledge/phenotype_definition.",
          "items": {
            "$ref": "#/$defs/QuoteReference"
          },
          "title": "Citations",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "relation": {
          "minLength": 1,
          "title": "Relation",
          "type": "string"
        },
        "scope": {
          "default": "phenotype_link",
          "description": "Use cell_identity for the step justifying which cell population is implicated; inferred identity needs inference/model_knowledge.",
          "enum": [
            "phenotype_link",
            "cell_identity",
            "mechanism"
          ],
          "title": "Scope",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "relation",
        "basis",
        "explanation"
      ],
      "title": "ReasoningStep",
      "type": "object"
    },
