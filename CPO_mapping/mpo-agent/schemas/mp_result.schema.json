          "anyOf": [
            {
              "$ref": "#/$defs/MouseModel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phenotype_id": {
          "pattern": "^MP:[0-9]{7}$",
          "title": "Phenotype Id",
          "type": "string"
