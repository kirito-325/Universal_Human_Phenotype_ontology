        },
        "definition": {
          "default": "",
          "title": "Definition",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "namespace": {
          "default": "",
          "title": "Namespace",
          "type": "string"
        },
        "obsolete": {
          "default": false,
          "title": "Obsolete",
          "type": "boolean"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "title": "Parents",
          "type": "array"
        },
