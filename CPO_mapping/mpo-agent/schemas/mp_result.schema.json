    "Phenotype": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "default": "",
          "title": "Definition",
          "type": "string"
        },
        "disease_contexts": {
          "items": {
            "type": "string"
          },
          "title": "Disease Contexts",
          "type": "array"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
