{
  "$defs": {
    "HypothesisProposal": {
      "additionalProperties": false,
      "properties": {
        "cell_text": {
          "minLength": 1,
          "title": "Cell Text",
          "type": "string"
        },
        "direction": {
          "description": "Direction of the named cellular process in process_text, or the cellular quality in quality_text when process_text is empty; not the polarity of the input radiographic/clinical phenotype.",
          "enum": [
            "increased",
            "decreased",
            "abnormal",
            "absent",
            "present",
            "bidirectional",
            "unknown"
          ],
          "title": "Direction",
          "type": "string"
        },
        "direction_id": {
          "minLength": 1,
          "title": "Direction Id",
          "type": "string"
        },
        "mechanism": {
          "minLength": 1,
          "title": "Mechanism",
          "type": "string"
        },
        "model_knowledge_basis": {
          "default": "",
          "title": "Model Knowledge Basis",
          "type": "string"
        },
        "process_text": {
          "minLength": 1,
          "title": "Process Text",
          "type": "string"
        },
        "seed_evidence_refs": {
          "description": "Read evidence_ref IDs that inspired this candidate; the host creates source quotes and offsets.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Seed Evidence Refs",
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "why_distinct": {
          "minLength": 1,
          "title": "Why Distinct",
          "type": "string"
        }
      },
      "required": [
        "title",
        "direction_id",
        "cell_text",
        "process_text",
        "direction",
        "mechanism",
        "why_distinct",
        "seed_evidence_refs"
      ],
      "title": "HypothesisProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "diversity_rationale": {
      "minLength": 1,
      "title": "Diversity Rationale",
      "type": "string"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/HypothesisProposal"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "limitation": {
      "default": "",
      "title": "Limitation",
      "type": "string"
    }
  },
  "required": [
    "hypotheses",
    "diversity_rationale"
  ],
  "title": "HypothesisProposals",
  "type": "object"
}
